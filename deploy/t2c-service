#!/bin/bash
# Run the Slack front door from a tagged release under launchd (T26). See docs/deploy.md.
# Lives in ~/.t2c because macOS refuses a launchd job access to ~/Documents.
set -euo pipefail

LABEL="io.t2c.slack"
SERVICE_HOME="$HOME/.t2c"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
SETTINGS="ANTHROPIC_API_KEY SLACK_BOT_TOKEN SLACK_APP_TOKEN T2C_MARKETERS"
OPTIONAL_SETTINGS="FILM_BUDGET_USD T2C_WATCHER T2C_WHISPER_MODEL" # launchd doesn't load the shell, so these go too
STOP_WAIT="${T2C_STOP_WAIT:-900}"                                  # the plist's ExitTimeOut: a Run finishes its stage
START_WAIT="${T2C_START_WAIT:-15}"

die() {
    echo "t2c-service: $*" >&2
    exit 1
}

make_home() {
    mkdir -p "$SERVICE_HOME"
    chmod 700 "$SERVICE_HOME"
}

xml_escape() {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

write_plist() {
    local home script logs
    home=$(xml_escape "$SERVICE_HOME")
    script="$home/current/deploy/run-slack.sh"
    logs="$home/logs/slack.log"
    cat >"$1" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key>
    <array><string>/bin/sh</string><string>$script</string></array>
    <key>WorkingDirectory</key><string>$home</string>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>ExitTimeOut</key><integer>900</integer>
    <key>StandardOutPath</key><string>$logs</string>
    <key>StandardErrorPath</key><string>$logs</string>
</dict>
</plist>
EOF
}

cmd_secrets() {
    local name value missing="" new="$SERVICE_HOME/env.new"
    for name in $SETTINGS; do
        [ -n "${!name:-}" ] || missing="$missing $name"
    done
    [ -z "$missing" ] || die "not set in this shell:$missing"
    make_home
    (
        umask 077
        for name in $SETTINGS $OPTIONAL_SETTINGS; do
            [ -n "${!name:-}" ] || continue
            value=$(printf '%s' "${!name}" | sed "s/'/'\\\\''/g")
            printf "export %s='%s'\n" "$name" "$value"
        done >"$new"
    )
    mv "$new" "$SERVICE_HOME/env"
    echo "wrote $SERVICE_HOME/env, readable only by you"
}

# A service's Film is a copy, so a changed Spoiler List does nothing until add-film copies it again.
warn_stale_films() {
    local repo copy slug
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    for copy in "$SERVICE_HOME"/films/*/film.toml; do
        [ -f "$copy" ] || continue
        slug=$(basename "$(dirname "$copy")")
        if [ -f "$repo/films/$slug/film.toml" ] && ! cmp -s "$copy" "$repo/films/$slug/film.toml"; then
            echo "t2c-service: WARNING: $slug differs from the repo's film.toml, so the Checker may be using an old Spoiler List. Run: deploy/t2c-service add-film $slug" >&2
        fi
    done
}

service_state() { # one tab: the service itself, not the nested lines about its endpoints
    launchctl print "$DOMAIN/$LABEL" 2>/dev/null | grep -E "^$(printf '\t')(state|pid|last exit code) ="
}

stop_service() {
    local waited=0
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true # ends a waiting Run in an error, never an Approval
    while launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; do
        if [ "$waited" -ge "$STOP_WAIT" ]; then
            die "the service is still stopping after ${STOP_WAIT}s, probably finishing a Run's stage. Nothing else changed: run this again later"
        fi
        sleep 1
        waited=$((waited + 1))
    done
}

cmd_install() {
    local tag="${1:-}" repo release plist_new commit created="" waited=0
    [[ "$tag" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "install needs a tag name, like v0.1.0"
    repo=$(git rev-parse --show-toplevel) || die "run this from the repo"
    commit=$(git -C "$repo" rev-parse -q --verify "refs/tags/$tag^{commit}") || die "no tag named $tag"
    [ -f "$SERVICE_HOME/env" ] || die "no $SERVICE_HOME/env yet; run: deploy/t2c-service secrets"

    make_home
    mkdir -p "$SERVICE_HOME/releases" "$SERVICE_HOME/logs" "$SERVICE_HOME/films" "$(dirname "$PLIST")"
    release="$SERVICE_HOME/releases/$tag"
    if [ -d "$release" ]; then
        [ "$(cat "$release/.t2c-commit" 2>/dev/null)" = "$commit" ] ||
            die "$tag moved since it was installed. A release is what its tag was, so cut a new tag"
    else
        rm -rf "$release.new" # left by an install that was interrupted
        mkdir "$release.new"
        git -C "$repo" archive "refs/tags/$tag" | tar -x -C "$release.new"
        printf '%s\n' "$commit" >"$release.new/.t2c-commit"
        if [ ! -f "$release.new/deploy/run-slack.sh" ]; then
            rm -rf "$release.new"
            die "$tag has no deploy/run-slack.sh, so it can't run as a service; it's older than this kit"
        fi
        mv "$release.new" "$release"
        created=yes
    fi
    if ! uv sync --locked --no-dev --project "$release" || [ ! -e "$release/.venv/bin/t2c" ]; then
        [ -z "$created" ] || rm -rf "$release"
        die "couldn't install $tag's dependencies; the running release is unchanged"
    fi

    plist_new="$PLIST.new"
    write_plist "$plist_new"
    if ! plutil -lint "$plist_new" >/dev/null; then
        rm -f "$plist_new"
        die "the generated plist isn't valid; the running release is unchanged"
    fi

    stop_service
    ln -sfn "$release" "$SERVICE_HOME/current"
    mv "$plist_new" "$PLIST"
    launchctl bootstrap "$DOMAIN" "$PLIST" || die "launchd wouldn't load $tag, so the service is down. Try: deploy/t2c-service install $tag"
    warn_stale_films
    while ! service_state | grep -q 'state = running'; do
        if [ "$waited" -ge "$START_WAIT" ]; then
            die "$tag isn't running after ${START_WAIT}s. See why with: deploy/t2c-service logs"
        fi
        sleep 1
        waited=$((waited + 1))
    done
    echo "$tag is running. Check it with: deploy/t2c-service status"
}

cmd_add_film() {
    local slug="${1:-}" repo source target
    [[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "add-film needs a Film's slug, not a path" # FILM_SLUG in run_log.py
    repo=$(git rev-parse --show-toplevel) || die "run this from the repo"
    source="$repo/films/$slug"
    [ ! -L "$source" ] && [ -f "$source/film.toml" ] || die "no Film at films/$slug (it needs a film.toml)"
    make_home
    mkdir -p "$SERVICE_HOME/films"
    target="$SERVICE_HOME/films/$slug"
    # Over the existing copy, so a Run using its frames keeps them. film.toml last, and swapped in whole.
    mkdir -p "$target"
    rsync -a --ignore-existing --exclude film.toml "$source/" "$target/"
    cp "$source/film.toml" "$target/film.toml.new"
    mv "$target/film.toml.new" "$target/film.toml"
    echo "copied $slug to the service's Films. Copy it again after changing its Spoiler List."
}

cmd_status() {
    if [ -L "$SERVICE_HOME/current" ]; then
        echo "release: $(basename "$(readlink "$SERVICE_HOME/current")")"
    fi
    service_state || echo "launchd has no state for $LABEL"
    warn_stale_films
}

cmd_logs() {
    tail -n "${1:-50}" "$SERVICE_HOME/logs/slack.log"
}

cmd_uninstall() {
    stop_service
    rm -f "$PLIST" "$SERVICE_HOME/env"
    echo "stopped, and removed its secrets. The rest of $SERVICE_HOME stays: its Run Logs and Films may be the only copy."
}

command="${1:-}"
[ "$#" -eq 0 ] || shift
case "$command" in
secrets) cmd_secrets ;;
install) cmd_install "$@" ;;
add-film) cmd_add_film "$@" ;;
status) cmd_status ;;
logs) cmd_logs "$@" ;;
uninstall) cmd_uninstall ;;
*) die "usage: t2c-service secrets | install <tag> | add-film <slug> | status | logs [lines] | uninstall" ;;
esac
